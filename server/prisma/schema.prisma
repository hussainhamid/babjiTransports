// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VehicleCategory {
  PASSENGER
  GOODS
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

model Vehicle {
  id String @id @default(cuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  vehicleName String

  brand String

  model String

  category VehicleCategory

  fuelType FuelType

  transmission Transmission

  seats Int?

  loadCapacity String?

  city String

  image String

  pricePerKm Float

  minimumFare Float

  isAvailable Boolean @default(true)

  bookings Booking[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  OWNER
  DRIVER
  CUSTOMER
}

model User {
  id    String  @id @default(cuid())
  name  String
  phone String  @unique
  email String?
  role  Role

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedVehicles  Vehicle[]
  assignedTrips  Booking[]     @relation("AssignedDriver")
  customerTrips  Booking[]     @relation("CustomerBookings")
  managedDrivers DriverOwner[] @relation("OwnerRelation")
  owners         DriverOwner[] @relation("DriverRelation")
  bookings       Booking[]

  @@index([role])
}

model DriverOwner {
  id String @id @default(cuid())

  ownerId  String
  driverId String

  owner  User @relation("OwnerRelation", fields: [ownerId], references: [id])
  driver User @relation("DriverRelation", fields: [driverId], references: [id])

  isActive Boolean @default(true)

  joinedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, driverId])
}

enum BookingStatus {
  PENDING

  DRIVER_ASSIGNED

  CONFIRMED

  ONGOING

  COMPLETED

  CANCELLED
}

model Booking {
  id String @id @default(cuid())

  customerId String
  customer   User   @relation("CustomerBookings", fields: [customerId], references: [id])

  driverId String?
  driver   User?   @relation("AssignedDriver", fields: [driverId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  pickupLocation String

  destination String

  bookingDate DateTime

  estimatedFare Float?

  advancePaid Float?

  remainingAmount Float?

  status BookingStatus @default(PENDING)

  payment Payment?

  invoice Invoice?

  isArchived Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@index([status])
}

model Payment {
  id String @id @default(cuid())

  bookingId String @unique

  booking Booking @relation(fields: [bookingId], references: [id])

  razorpayOrderId String?

  razorpayPaymentId String?

  advanceAmount Float

  finalAmount Float?

  companyCommission Float

  driverAmount Float

  status String

  isVoided Boolean @default(false)

  createdAt DateTime @default(now())
}

model Invoice {
  id String @id @default(cuid())

  bookingId String @unique

  booking Booking @relation(fields: [bookingId], references: [id])

  fuelCost Float @default(0)

  tollCost Float @default(0)

  parkingCost Float @default(0)

  fineCost Float @default(0)

  otherCost Float @default(0)

  totalAmount Float

  createdAt DateTime @default(now())
}
